# Copy to .env.local and fill in. Never commit real values.

# Supabase project (Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable (anon) key — safe for the browser
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# Canonical site origin used for metadata, robots and sitemap
NEXT_PUBLIC_SITE_URL=https://www.learnssb.online

# Optional contact links. Leave empty to hide the floating icons.
NEXT_PUBLIC_WHATSAPP_URL=
NEXT_PUBLIC_TELEGRAM_URL=
